{
  "expo": {
    "name": "Porto Alegre 24h TV",
    "slug": "poptv-app",
    "version": "3.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-poa.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ormartins.poptvapp",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.ormartins.poptvapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Porto Alegre 24 horas TV",
      "backgroundColor": "#000000"
    },
    "extra": {
      "eas": {
        "projectId": "c3347070-5c2d-48de-b8e1-67ac53e5e918"
      }
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": false,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "runtimeVersion": "3.2.0",
    "updates": {
      "url": "https://u.expo.dev/c3347070-5c2d-48de-b8e1-67ac53e5e918"
    }
  }
}
